Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /DA360 PointCloud1
        - /DA360 PointCloud1/Topic1
        - /DA360 Depth1
        - /DA360 Depth1/Topic1
      Splitter Ratio: 0.5
    Tree Height: 115
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.25
